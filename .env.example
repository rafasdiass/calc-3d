# calc-3d — variáveis de ambiente
# Copiar para .env e preencher os valores reais.
# NUNCA commitar o .env com valores reais.

# --- API ---
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://calc3d:calc3d@localhost:5432/calc3d

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
S3_BUCKET_NAME=calc3d-artifacts
# S3_ENDPOINT_URL=https://your-r2-endpoint.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO
