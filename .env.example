# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://calc3d:calc3d@localhost:5432/calc3d
DATABASE_URL_SYNC=postgresql+psycopg2://calc3d:calc3d@localhost:5432/calc3d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute per tenant
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=600

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ─── Postgres superuser (used by docker-compose only) ─────────────────────────
POSTGRES_USER=calc3d
POSTGRES_PASSWORD=calc3d
POSTGRES_DB=calc3d
