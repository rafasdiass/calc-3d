# Copie este arquivo para .env e ajuste os valores
# .env NÃO é versionado (ver .gitignore)

# ── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_USER=lct
POSTGRES_PASSWORD=lct_dev
POSTGRES_DB=lct_calculator

# URL montada pelo docker-compose; em desenvolvimento local use:
# DATABASE_URL=postgresql+asyncpg://lct:lct_dev@localhost:5432/lct_calculator
DATABASE_URL=postgresql+asyncpg://lct:lct_dev@db:5432/lct_calculator

# ── API ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
